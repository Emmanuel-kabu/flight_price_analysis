# Airflow service Dockerfile
FROM apache/airflow:2.8.1-python3.9

# Switch to root to install system dependencies
USER root

# Install system dependencies for database connections and Kaggle
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    unzip \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Switch back to airflow user
USER airflow

# Install Airflow-specific dependencies (keep base app deps separate)
COPY requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir -r /tmp/requirements-airflow.txt

# Install additional Airflow providers
RUN pip install --no-cache-dir \
    apache-airflow-providers-postgres \
    apache-airflow-providers-mysql \
    apache-airflow-providers-docker \
    kaggle \
    pandas \
    numpy

# Set up Kaggle configuration directory
ENV KAGGLE_CONFIG_DIR=/home/airflow/.kaggle

# Create necessary directories
USER root
RUN mkdir -p /home/airflow/.kaggle && \
    chown -R airflow:root /home/airflow/.kaggle
USER airflow